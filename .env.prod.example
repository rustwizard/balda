# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

# Public domain pointing at this server (A-record). Caddy obtains the
# certificate for it automatically.
DOMAIN=balda.example.org

# JWT signing secret for access tokens.
AUTH_JWT_SECRET=

# Postgres password (used by the server and migrations too).
PG_PASSWORD=

# Centrifugo: HTTP API key (server -> centrifugo) and HMAC secret for
# client connection tokens.
CENTRIFUGO_API_KEY=
CENTRIFUGO_SECRET=
